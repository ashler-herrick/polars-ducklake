# Default integration-test config.
#
# These values match the project-local docker-compose stack at the repo
# root. Run `docker compose up -d` and the integration suite is ready
# to go — no further configuration needed.
#
# Tests prefer real environment variables over this file, so to point
# at a different stack just `export MINIO_ENDPOINT=...` etc. before
# running pytest. To make a per-developer override permanent, copy this
# file to tests/.env.local (gitignored) and edit there.

# --- MinIO ---
MINIO_ENDPOINT=http://localhost:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin-test-pwd
MINIO_REGION=us-east-1
MINIO_TEST_BUCKET=polars-ducklake-test

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-test-pwd
POSTGRES_TEST_DATABASE=polars_ducklake_test

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=13306
MYSQL_USER=root
MYSQL_PASSWORD=mysql-test-pwd
MYSQL_TEST_DATABASE=polars_ducklake_test
